# Copy this file to .env and fill in strong passwords before running docker compose up

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=
WORDPRESS_TABLE_PREFIX=wp_

# --- phpMyAdmin ---
PMA_HOST=db
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=
